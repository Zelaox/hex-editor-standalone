{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "revision", "feedback_priorities", "window_role_classifier", "boundary_planner", "measurement_engine", "change_point_inference", "scope_strategies", "executor", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "feedback_priorities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "window_role_classifier": {"$ref": "#/$defs/hook"},
    "boundary_planner": {"$ref": "#/$defs/hook"},
    "measurement_engine": {"$ref": "#/$defs/hook"},
    "change_point_inference": {"$ref": "#/$defs/hook"},
    "scope_strategies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hook"}},
    "executor": {"$ref": "#/$defs/hook"},
    "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hook"}}
  },
  "$defs": {"hook": {"type": "object", "required": ["id", "impl"], "properties": {"id": {"type": "string"}, "impl": {"type": "object", "required": ["module", "callable"], "properties": {"module": {"type": "string"}, "callable": {"type": "string"}}, "additionalProperties": false}}, "additionalProperties": false}}
}
