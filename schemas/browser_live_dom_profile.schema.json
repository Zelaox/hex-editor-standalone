{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "origins", "conversation_path_pattern", "selectors", "max_input_bytes", "max_groups", "max_rows", "max_parts_per_row", "max_text_chars", "server_timeout_seconds", "request_timeout_seconds"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1},
    "origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://"}},
    "conversation_path_pattern": {"type": "string", "minLength": 1},
    "selectors": {"type": "object", "additionalProperties": false, "required": ["groups", "rows", "text_parts", "sender", "timestamp"], "properties": {
      "groups": {"type": "string", "minLength": 1}, "rows": {"type": "string", "minLength": 1}, "text_parts": {"type": "string", "minLength": 1}, "sender": {"type": "string", "minLength": 1}, "timestamp": {"type": "string", "minLength": 1}
    }},
    "max_input_bytes": {"type": "integer", "minimum": 1}, "max_groups": {"type": "integer", "minimum": 1}, "max_rows": {"type": "integer", "minimum": 1}, "max_parts_per_row": {"type": "integer", "minimum": 1}, "max_text_chars": {"type": "integer", "minimum": 1}, "server_timeout_seconds": {"type": "integer", "minimum": 1}, "request_timeout_seconds": {"type": "integer", "minimum": 1}
  }
}
