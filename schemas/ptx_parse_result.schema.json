{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PtxParseResult",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "source",
    "header",
    "sections",
    "timecodes",
    "consistency_checks",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "ok": {"type": "boolean"},
    "source": {
      "type": "object",
      "required": ["sha256", "size", "path"],
      "properties": {
        "sha256": {"type": "string"},
        "size": {"type": "integer"},
        "path": {"type": "string"}
      }
    },
    "header": {"type": "object"},
    "sections": {"type": "array"},
    "timecodes": {"type": "array"},
    "metadata": {"type": "object"},
    "consistency_checks": {"type": "array"},
    "warnings": {"type": "array"},
    "error": {"type": "string"}
  },
  "additionalProperties": true
}
