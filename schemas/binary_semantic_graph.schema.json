{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "graph_id", "revision", "nodes", "edges", "indexes", "validation"],
  "properties": {
    "schema_version": {"const": 1}, "graph_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["node_id", "node_type", "truth_state", "attributes"], "properties": {"node_id": {"type": "string"}, "node_type": {"type": "string"}, "truth_state": {"enum": ["observed", "hypothesized", "tested", "verified", "falsified", "inconclusive", "superseded"]}, "attributes": {"type": "object"}}, "additionalProperties": false}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["edge_id", "edge_type", "source_id", "target_id", "truth_state", "evidence_refs"], "properties": {"edge_id": {"type": "string"}, "edge_type": {"type": "string"}, "source_id": {"type": "string"}, "target_id": {"type": "string"}, "truth_state": {"enum": ["observed", "hypothesized", "tested", "verified", "falsified", "inconclusive", "superseded"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "indexes": {"type": "object"}, "validation": {"type": "object", "required": ["valid", "errors"], "properties": {"valid": {"type": "boolean"}, "errors": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
