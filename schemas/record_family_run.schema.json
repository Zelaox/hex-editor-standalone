{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "source", "parent", "policy_digest", "registry_digest", "implementation_digest", "run_root", "proof_ids", "candidate_ids", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["family_proof_satisfied", "goal_satisfied", "evidence_exhausted", "budget_exhausted", "insufficient_independence", "all_hypotheses_falsified", "policy_blocked", "integrity_failed", "failed"]},
    "source": {"$ref": "#/$defs/input"},
    "parent": {"$ref": "#/$defs/input"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "registry_digest": {"$ref": "#/$defs/digest"},
    "implementation_digest": {"$ref": "#/$defs/digest"},
    "run_root": {"type": "string"},
    "proof_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
