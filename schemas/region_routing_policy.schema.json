{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "policy_id", "revision", "format_detect_registry_path", "merge_policy_path", "plugin_region_strategies", "region_classes"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "format_detect_registry_path": { "type": "string" },
    "merge_policy_path": { "type": "string" },
    "decompiler_policy_path": { "type": "string" },
    "prefix_read_bytes": { "type": "integer", "minimum": 16 },
    "plugin_region_strategies": { "type": "object" },
    "region_classes": { "type": "object" }
  },
  "additionalProperties": true
}
