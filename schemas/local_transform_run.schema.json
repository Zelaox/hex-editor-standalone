{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "source", "parent", "policy_digest", "registry_digest", "run_root", "selected_candidate_id", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["goal_satisfied", "evidence_exhausted", "budget_exhausted", "blocked", "failed"]},
    "source": {"$ref": "#/$defs/input"},
    "parent": {"anyOf": [{"$ref": "#/$defs/input"}, {"type": "null"}]},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_root": {"type": "string"},
    "selected_candidate_id": {"type": ["string", "null"]},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
