{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delta_id", "delta_kind", "from", "to", "lineage_key", "summary", "spans", "plaintext", "parser_semantic", "gates", "transform_regime", "lineage"],
  "properties": {
    "schema_version": {"const": 1},
    "delta_id": {"type": "string"},
    "delta_kind": {"type": "string", "enum": ["parent_to_child", "run_to_run", "candidate_to_candidate"]},
    "from": {"type": "object"},
    "to": {"type": "object"},
    "lineage_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "object"},
    "spans": {"type": "object"},
    "plaintext": {"type": "object"},
    "parser_semantic": {"type": "object"},
    "gates": {"type": "object"},
    "transform_regime": {"type": "object"},
    "lineage": {"type": "object"}
  }
}
