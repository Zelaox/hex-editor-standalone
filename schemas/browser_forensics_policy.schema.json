{
 "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
 "required": ["schema_version", "revision", "format_registry", "budgets", "worker", "normalization", "profiles", "fuzz", "indexer_id", "companions"],
 "properties": {
  "schema_version": {"const": 1}, "revision": {"type": "integer", "minimum": 1}, "format_registry": {"type": "string"}, "indexer_id": {"type": "string"},
  "companions": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
  "budgets": {"type": "object", "additionalProperties": false, "required": ["max_file_bytes", "max_total_bytes", "max_files", "max_records", "max_fields", "max_depth", "max_expanded_bytes", "max_output_bytes", "cpu_seconds", "wall_seconds", "memory_bytes", "max_processes"], "properties": {
    "max_file_bytes": {"type": "integer", "minimum": 1}, "max_total_bytes": {"type": "integer", "minimum": 1}, "max_files": {"type": "integer", "minimum": 1}, "max_records": {"type": "integer", "minimum": 1}, "max_fields": {"type": "integer", "minimum": 1}, "max_depth": {"type": "integer", "minimum": 1}, "max_expanded_bytes": {"type": "integer", "minimum": 1}, "max_output_bytes": {"type": "integer", "minimum": 1}, "cpu_seconds": {"type": "integer", "minimum": 1}, "wall_seconds": {"type": "integer", "minimum": 1}, "memory_bytes": {"type": "integer", "minimum": 1}, "max_processes": {"type": "integer", "minimum": 1}
  }},
  "worker": {"type": "object", "additionalProperties": false, "required": ["backend", "wsl_distribution", "linux_python", "executable", "runtime_roots", "uid", "gid", "deny_syscalls"], "properties": {"backend": {"const": "bubblewrap"}, "wsl_distribution": {"type": "string"}, "linux_python": {"type": "string"}, "executable": {"type": "string"}, "runtime_roots": {"type": "array", "items": {"type": "string"}}, "uid": {"type": "integer", "minimum": 1}, "gid": {"type": "integer", "minimum": 1}, "deny_syscalls": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}},
  "normalization": {"type": "object", "additionalProperties": false, "required": ["version", "encoding", "sort_keys"], "properties": {"version": {"const": 1}, "encoding": {"const": "utf-8"}, "sort_keys": {"const": true}}},
  "profiles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "rules"], "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "rules": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["field", "finding_type", "status"], "properties": {"field": {"type": "string", "minLength": 1}, "finding_type": {"enum": ["marker_occurrence", "identifier", "key_reference", "wrapped_key_blob", "session_metadata", "ciphertext_record"]}, "status": {"enum": ["candidate", "observed"]}, "encodings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["utf-8", "utf-16le", "utf-16be"]}}, "locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["key", "value"]}}}}}}}},
  "fuzz": {"type": "object", "additionalProperties": false, "required": ["seed", "iterations", "max_input_bytes", "harnesses", "minimize_steps"], "properties": {"seed": {"type": "integer"}, "iterations": {"type": "integer", "minimum": 1}, "max_input_bytes": {"type": "integer", "minimum": 1}, "minimize_steps": {"type": "integer", "minimum": 1}, "harnesses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}
 }
}
