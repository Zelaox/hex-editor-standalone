{
  "schema_version": 1,
  "policy_id": "ptx-pipeline",
  "revision": 1,
  "artifact_root": "data/artifacts/hex_editor/ptx_pipeline_runs",
  "parser_policy_file": "config/ptx_parse_policy.json",
  "source_archive_policy_file": "config/source_archive_policy.json",
  "converter_policy_file": "config/ptx_converter_policy.json",
  "no_hardcode_manifest_file": "config/ptx_pipeline_no_hardcode_manifest.json",
  "materialization": {
    "manifest_filename": "manifest.json",
    "source_path_keys": [
      "source.path",
      "source_before.path"
    ],
    "candidate_path_keys": [
      "output.candidate_path",
      "artifact_path"
    ],
    "promotion_flag_keys": [
      "promotion_eligible",
      "details.promotion_eligible"
    ],
    "require_promotion_by_default": true
  },
  "gui": {
    "window_title": "PTX Parser / Converter Pipeline",
    "default_stages": ["analyze", "extract", "graph"],
    "include_bind_on_full_run": true
  },
  "rails": {
    "evidence-driven-local-transform-regimes": {
      "policy_file": "config/local_transform_policy.json"
    },
    "evidence-driven-record-family-proof": {
      "policy_file": "config/record_family_policy.json"
    }
  }
}
