{
  "schema_version": 1,
  "policy_id": "preserved-binary-ownership-inference",
  "revision": 3,
  "artifact_root": "data/artifacts/hex_editor/preserved_binary_inference_runs",
  "finding_ledger": {
    "root": "data/artifacts/hex_editor/finding_ledger",
    "maximum_summary_chars": 512
  },
  "forensic_bundle": {
    "enabled": true,
    "emit_on_run_complete": true
  },
  "topology": {
    "cluster_max_gap_bytes": 0,
    "maximum_cluster_spans": 512,
    "context_before_bytes": 32,
    "context_after_bytes": 32,
    "alignment_widths": [1, 2, 4, 8, 16],
    "maximum_spans": 16384
  },
  "inference": {
    "integer_widths": [1, 2, 4, 8],
    "endian_modes": ["little", "big"],
    "maximum_hypotheses_per_span": 8,
    "minimum_independent_occurrences": 2,
    "maximum_graph_query_depth": 16,
    "maximum_graph_query_results": 4096
  },
  "materialization": {
    "maximum_candidates": 256,
    "maximum_changed_bytes": 0,
    "allow_classification_only_candidates": true
  },
  "validation": {
    "require_upstream_verified": true,
    "require_upstream_zero_unresolved": true,
    "require_source_preserved": true,
    "require_parent_preserved": true,
    "require_candidate_preserved": true,
    "require_coverage_complete": true,
    "require_graph_valid": true,
    "require_inverse_replay": true,
    "require_scope_confinement": true,
    "require_parent_baseline_complete": true
  },
  "objectives": [
    {"id": "owned_preserved_bytes", "direction": "maximize"},
    {"id": "structural_metadata_bytes", "direction": "maximize"},
    {"id": "unowned_preserved_bytes", "direction": "minimize"},
    {"id": "orphan_nodes", "direction": "minimize"}
  ],
  "closure": {
    "maximum_turns": 8,
    "require_gemma_for_terminal_rank": false
  },
  "model_boundary": {
    "grammar_path": "config/grammars/preserved_binary_advisory.gbnf",
    "maximum_attempts": 3,
    "maximum_tokens": 128,
    "temperature": 0.0,
    "allowed_actions": ["prioritize_existing_cluster", "rank_existing_hypothesis"],
    "forbidden_fields": ["offset", "start", "end", "length", "bytes", "bytes_hex", "key", "key_hex", "transform_parameter", "promotion_allowed", "verified_decryption"]
  }
}
